# Normalise line endings so the repo is identical on every platform.
* text=auto eol=lf

# Windows batch files must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf

# Shell scripts must keep LF even on Windows checkouts, otherwise
# bash fails with "\r: command not found".
*.sh  text eol=lf

# Binary assets — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.zip  binary

# Keep the vendored library out of language stats and diffs.
web/vendor/* linguist-vendored
